{
  "name": "quark-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Quark monorepo — @quark/runner engine + quark CLI/TUI",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --cwd packages/runner build && bun run --cwd packages/acp build && bun run --cwd packages/quark build",
    "typecheck": "bun run --cwd packages/runner typecheck && bun run --cwd packages/acp typecheck && bun run --cwd packages/quark typecheck",
    "test": "bun test",
    "dev": "bun --preload ./packages/quark/preload.ts packages/quark/src/tui/index.tsx",
    "cli": "bun --preload ./packages/quark/preload.ts packages/quark/src/cli.ts",
    "install:local": "bun scripts/install-local.ts",
    "verify:install": "bun scripts/verify-install.ts",
    "docs": "typedoc"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^25.5.0",
    "typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0",
    "typescript": "^6.0.2"
  }
}
